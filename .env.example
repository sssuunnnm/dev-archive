# SEO / 방문자 분석 (선택) — 값을 채우면 빌드 시 자동으로 활성화됨
# 로컬 개발 시에는 .env로 복사해서 사용, 배포는 GitHub repo Settings → Secrets and variables → Actions → Variables에 동일한 이름으로 등록

# GoatCounter(https://goatcounter.com) 무료 가입 후 사이트 코드만 입력 (예: mycode.goatcounter.com이면 mycode)
PUBLIC_GOATCOUNTER_CODE=

# Google Search Console에서 소유권 확인용 HTML 태그 방식 선택 시 나오는 content 값만 입력
PUBLIC_GOOGLE_SITE_VERIFICATION=
