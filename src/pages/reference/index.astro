---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const references = (await getCollection('references')).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);
---

<BaseLayout title="Reference" description="계속 갱신되는 참고 문서 목록">
  <h1 class="text-2xl font-bold mb-6">Reference</h1>

  {references.length === 0 ? (
    <p class="text-gray-400 text-sm">아직 등록된 참고 문서가 없습니다.</p>
  ) : (
    <ul class="space-y-4">
      {references.map((ref) => (
        <li class="border-b pb-4 dark:border-gray-800">
          <a
            href={`${import.meta.env.BASE_URL}reference/${ref.id}`}
            class="text-lg font-medium hover:underline"
          >
            {ref.data.title}
          </a>
          <div class="flex flex-wrap gap-2 mt-2 text-xs text-gray-400">
            <span>Updated {ref.data.updated.toISOString().slice(0, 10)}</span>
            {ref.data.tags.map((t: string) => (
              <span>#{t}</span>
            ))}
          </div>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>