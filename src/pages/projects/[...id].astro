---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryLabel } from '../../lib/categories';
import { isVisible } from '../../lib/content-visibility';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => isVisible(data.draft));
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL;

// DESIGN_RULES 4-2: projects 필드로 Article ↔ Project 양방향 연결
const allArticles = await getCollection('articles', ({ data }) => isVisible(data.draft));
const relatedArticles = allArticles.filter((post) => post.data.projects?.includes(entry.id));

const statusLabel: Record<string, string> = {
  'in-progress': '진행중',
  done: '완료',
  archived: '보관',
};
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <header class="mb-8">
    <div class="flex items-center gap-2 mb-2">
      <h1 class="text-3xl font-bold">{entry.data.title}</h1>
      <span class="text-xs rounded-full px-2.5 py-0.5 bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">
        {statusLabel[entry.data.status] ?? entry.data.status}
      </span>
    </div>
    <p class="text-gray-500 mb-3">{entry.data.summary}</p>

    <div class="flex flex-wrap gap-2 text-xs text-gray-400 mb-3">
      <span>{entry.data.startDate.toISOString().slice(0, 10)}</span>
      {entry.data.endDate && <span>~ {entry.data.endDate.toISOString().slice(0, 10)}</span>}
      {entry.data.github && (
        <>
          <span>·</span>
          <a href={entry.data.github} class="text-accent dark:text-accent-dark hover:underline">
            GitHub
          </a>
        </>
      )}
    </div>

    <div class="flex flex-wrap gap-2">
      {entry.data.stack.map((s: string) => (
        <span class="text-xs rounded-full px-3 py-1 bg-gray-100 dark:bg-gray-800">{s}</span>
      ))}
    </div>
  </header>

  {entry.data.features && entry.data.features.length > 0 && (
    <section class="mb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold text-gray-400 mr-1">이런 제품</span>
        {entry.data.features.map((f: string) => (
          <span class="text-xs rounded-full px-3 py-1 bg-gray-100 dark:bg-gray-800">{f}</span>
        ))}
      </div>
    </section>
  )}

  {entry.data.highlights && entry.data.highlights.length > 0 && (
    <section class="grid gap-4 sm:grid-cols-3 mb-10">
      {entry.data.highlights.map((h: { icon: string; title: string; description: string; tag: string }) => (
        <div class="rounded-xl bg-gray-50 dark:bg-gray-900/40 p-4">
          <p class="text-2xl mb-2">{h.icon}</p>
          <p class="font-semibold mb-1">{h.title}</p>
          <p class="text-sm text-gray-500 mb-3">{h.description}</p>
          <span class="text-xs rounded-full px-2.5 py-0.5 bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            {h.tag}
          </span>
        </div>
      ))}
    </section>
  )}

  <div class="prose prose-gray dark:prose-invert max-w-none">
    <Content />
  </div>

  {relatedArticles.length > 0 && (
    <footer class="mt-8 pt-6 border-t dark:border-gray-700">
      <p class="font-semibold mb-2">이 프로젝트 관련 글</p>
      <ul class="space-y-2">
        {relatedArticles.map((post) => (
          <li class="flex items-center gap-2">
            <span class="text-xs text-gray-400 rounded-full px-2 py-0.5 bg-gray-100 dark:bg-gray-800">
              {getCategoryLabel(post.data.category)}
            </span>
            <a
              href={`${base}${post.data.category}/${post.id}`}
              class="text-accent dark:text-accent-dark hover:underline"
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </footer>
  )}
</BaseLayout>