---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryLabel } from '../../lib/categories';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL;

// DESIGN_RULES 4-2: projects 필드로 Article ↔ Project 양방향 연결
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const relatedArticles = allArticles.filter((post) => post.data.projects?.includes(entry.id));

const statusLabel: Record<string, string> = {
  'in-progress': '진행중',
  done: '완료',
  archived: '보관',
};
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <header class="mb-8">
    <div class="flex items-center gap-2 mb-2">
      <h1 class="text-3xl font-bold">{entry.data.title}</h1>
      <span class="text-xs border rounded px-2 py-0.5 text-gray-500 dark:border-gray-700">
        {statusLabel[entry.data.status] ?? entry.data.status}
      </span>
    </div>
    <p class="text-gray-500 mb-3">{entry.data.summary}</p>

    <div class="flex flex-wrap gap-2 text-xs text-gray-400 mb-3">
      <span>{entry.data.startDate.toISOString().slice(0, 10)}</span>
      {entry.data.endDate && <span>~ {entry.data.endDate.toISOString().slice(0, 10)}</span>}
      {entry.data.github && (
        <>
          <span>·</span>
          <a href={entry.data.github} class="text-accent dark:text-accent-dark hover:underline">
            GitHub
          </a>
        </>
      )}
    </div>

    <div class="flex flex-wrap gap-2">
      {entry.data.stack.map((s: string) => (
        <span class="text-xs border rounded px-2 py-1 dark:border-gray-700">{s}</span>
      ))}
    </div>
  </header>

  <div class="prose prose-gray dark:prose-invert max-w-none">
    <Content />
  </div>

  {relatedArticles.length > 0 && (
    <footer class="mt-8 pt-6 border-t dark:border-gray-700">
      <p class="font-semibold mb-2">이 프로젝트 관련 글</p>
      <ul class="space-y-2">
        {relatedArticles.map((post) => (
          <li class="flex items-center gap-2">
            <span class="text-xs text-gray-400 border rounded px-1.5 py-0.5 dark:border-gray-700">
              {getCategoryLabel(post.data.category)}
            </span>
            <a
              href={`${base}${post.data.category}/${post.id}`}
              class="text-accent dark:text-accent-dark hover:underline"
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </footer>
  )}
</BaseLayout>