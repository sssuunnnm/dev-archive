---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories, getCategoryColorClass } from '../../lib/categories';
import { isVisible } from '../../lib/content-visibility';

export async function getStaticPaths() {
  // 카테고리 6개 전부 고정 생성 (글이 없어도 페이지는 존재)
  return categories.map((c) => ({ params: { category: c.key } }));
}

const { category } = Astro.params;

const allArticles = await getCollection('articles', ({ data }) => isVisible(data.draft));
const posts = allArticles
  .filter((post) => post.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const current = categories.find((c) => c.key === category);
const label = current?.label ?? category;
---

<BaseLayout title={`${label} | Category`} description={`${label} 카테고리 글 목록`} ogType="website">
  <h1 class={`text-2xl font-bold mb-2 ${getCategoryColorClass(category as string)}`}>{label}</h1>
  <p class="text-sm text-gray-400 mb-8">{posts.length}개의 글</p>

  {posts.length === 0 ? (
    <p class="text-gray-400 text-sm">아직 이 카테고리에 작성된 글이 없습니다.</p>
  ) : (
    <ul class="space-y-4">
      {posts.map((post) => (
        <li class="border-b pb-4 dark:border-gray-800">
          <a
            href={`${import.meta.env.BASE_URL}${post.data.category}/${post.id}`}
            class="text-lg font-medium hover:underline"
          >
            {post.data.title}
          </a>
          <p class="text-sm text-gray-500 mt-1">{post.data.description}</p>
          <div class="flex flex-wrap gap-2 mt-2 text-xs text-gray-400">
            <span>{post.data.type}</span>
            <span>·</span>
            <span>{post.data.date.toISOString().slice(0, 10)}</span>
          </div>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>