---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { isVisible } from '../../lib/content-visibility';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => isVisible(data.draft));

  return articles.map((entry) => ({
    params: { category: entry.data.category, id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings}>
  <Content />
</ArticleLayout>