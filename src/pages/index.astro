---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MiniCalendar from '../components/MiniCalendar.astro';
import { categories, getCategoryLabel, getCategoryColorClass, getCategoryPillClass, getCategoryListItemHoverClass } from '../lib/categories';
import { isVisible } from '../lib/content-visibility';

const allArticles = await getCollection('articles', ({ data }) => isVisible(data.draft));
const recentPosts = allArticles
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

// 태그 빈도 집계 (상위 8개)
const tagCount: Record<string, number> = {};
for (const post of allArticles) {
  for (const tag of post.data.tags) {
    tagCount[tag] = (tagCount[tag] ?? 0) + 1;
  }
}
const popularTags = Object.entries(tagCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([tag]) => tag);
---

<BaseLayout title="My Dev Wiki" description="개발과 공부를 기록하는 공간" ogType="website">
  <div class="home-grid mb-10">
    <section class="home-intro">
      <h1 class="text-2xl font-bold mb-2 font-accent">안녕하세요.</h1>
      <p class="text-gray-500">개발과 공부를 기록하는 공간입니다.</p>
    </section>

    <section class="home-recent">
      <h2 class="text-lg font-semibold mb-3">Recent Posts</h2>
      <ul class="space-y-1">
        {recentPosts.map((post) => (
          <li>
            <a
              href={`${import.meta.env.BASE_URL}${post.data.category}/${post.id}`}
              class={`block -mx-3 rounded-lg px-3 py-2 transition-colors ${getCategoryListItemHoverClass(post.data.category)}`}
            >
              <span class="font-medium">{post.data.title}</span>
              <div class="flex flex-wrap gap-2 text-xs text-gray-400 mt-1">
                <span class={`font-medium ${getCategoryColorClass(post.data.category)}`}>{getCategoryLabel(post.data.category)}</span>
                <span>·</span>
                <span>{post.data.type}</span>
                <span>·</span>
                <span>{post.data.date.toISOString().slice(0, 10)}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-categories">
      <h2 class="text-lg font-semibold mb-3">Categories</h2>
      <div class="flex flex-wrap gap-2">
        {categories.map((c) => (
          <a
            href={`${import.meta.env.BASE_URL}${c.key}`}
            class={`text-xs font-medium rounded-full px-3 py-1 hover:opacity-80 ${getCategoryPillClass(c.key)}`}
          >
            {c.label}
          </a>
        ))}
      </div>
    </section>

    <MiniCalendar class="home-calendar" />
  </div>

  <section>
    <h2 class="text-lg font-semibold mb-3">Popular Tags</h2>
    <div class="flex flex-wrap gap-2">
      {popularTags.map((tag) => (
        <a
          href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}`}
          class="text-xs rounded-full px-3 py-1 bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700"
        >
          #{tag}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* MiniCalendar는 별도 컴포넌트라 Astro 스코프 스타일이 자동으로 안 먹기 때문에
     is:global로 전환. 클래스명이 home- 접두사로 구분되어 있어 충돌 위험은 낮다.
     모바일: 인사말 → Recent Posts → Categories → Calendar 순.
     Categories/Calendar가 커서 예전 순서(Categories/Calendar가 먼저)로는
     Recent Posts를 보려면 스크롤을 너무 많이 내려야 했다. */
  .home-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'intro'
      'recent'
      'categories'
      'calendar';
    gap: 1.5rem;
    align-items: start;
  }

  @media (width >= 48rem) {
    /* 데스크탑: 기존 2단 레이아웃(왼쪽 인사말+Categories, 오른쪽 Calendar) 유지 */
    .home-grid {
      grid-template-columns: 2fr 1fr;
      grid-template-areas:
        'intro calendar'
        'categories calendar'
        'recent recent';
    }
  }

  .home-intro {
    grid-area: intro;
  }

  .home-recent {
    grid-area: recent;
  }

  .home-categories {
    grid-area: categories;
  }

  .home-calendar {
    grid-area: calendar;
  }
</style>