---
// About 페이지 비교용 — 대표 프로젝트 미리보기를 3D 틸트 카드로.
// 보내주신 포트폴리오 참고 자료의 프로젝트 카드(hover 시 살짝 뜨는 카드 + 화살표가
// 오른쪽으로 이동)를 vanilla CSS/JS로 재현, 데이터는 content/projects/를 그대로 사용.
import { getCollection } from 'astro:content';
import { isVisible } from '../lib/content-visibility';
import { getTechLabel } from '../lib/tech-labels';
import { ArrowRight } from '@lucide/astro';

const projects = (await getCollection('projects', ({ data }) => isVisible(data.draft))).sort(
  (a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf()
);

const base = import.meta.env.BASE_URL;
---

<div class="tilt-grid" id="project-tilt-cards">
  {projects.map((p, i) => (
    <a class="tilt-card" href={`${base}projects/${p.id}`}>
      <span class="tilt-num">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="tilt-title">{p.data.title}</h3>
      <p class="tilt-summary">{p.data.summary}</p>
      <div class="tilt-chips">
        {p.data.stack.slice(0, 3).map((s) => (
          <span class="tilt-chip">{getTechLabel(s)}</span>
        ))}
      </div>
      <span class="tilt-arrow" aria-hidden="true"><ArrowRight size={16} /></span>
    </a>
  ))}
</div>

<style>
  .tilt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.875rem;
  }

  .tilt-card {
    position: relative;
    display: block;
    border-radius: 1rem;
    padding: 1.25rem 1.25rem 1.5rem;
    background: rgb(249 250 251);
    text-decoration: none;
    color: inherit;
    transform: perspective(700px) rotateX(0deg) rotateY(0deg) translateZ(0);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  :global(.dark) .tilt-card {
    background: rgb(24 24 27 / 0.6);
  }

  .tilt-card:hover,
  .tilt-card:focus-visible {
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.35);
  }

  .tilt-num {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 800;
    color: rgb(156 163 175);
  }

  .tilt-title {
    margin-top: 0.375rem;
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .tilt-summary {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(107 114 128);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.dark) .tilt-summary {
    color: rgb(156 163 175);
  }

  .tilt-chips {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tilt-chip {
    font-size: 0.6875rem;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: rgb(229 231 235);
    color: rgb(75 85 99);
  }

  :global(.dark) .tilt-chip {
    background: rgb(63 63 70);
    color: rgb(209 213 219);
  }

  .tilt-arrow {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    color: rgb(156 163 175);
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .tilt-card:hover .tilt-arrow,
  .tilt-card:focus-visible .tilt-arrow {
    transform: translateX(4px);
    color: var(--color-accent);
  }

  :global(.dark) .tilt-card:hover .tilt-arrow,
  :global(.dark) .tilt-card:focus-visible .tilt-arrow {
    color: var(--color-accent-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .tilt-card {
      transition: none;
      transform: none !important;
    }
  }
</style>

<script>
  const grid = document.getElementById('project-tilt-cards');
  if (!grid) throw new Error('ProjectTiltCards: root element not found');

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    grid.querySelectorAll<HTMLElement>('.tilt-card').forEach((card) => {
      const tiltRange = 6; // deg
      card.addEventListener('pointermove', (e: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;
        const rotateY = (x - 0.5) * tiltRange * 2;
        const rotateX = (0.5 - y) * tiltRange * 2;
        card.style.transform = `perspective(700px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(0)`;
      });
      card.addEventListener('pointerleave', () => {
        card.style.transform = 'perspective(700px) rotateX(0deg) rotateY(0deg) translateZ(0)';
      });
    });
  }
</script>
