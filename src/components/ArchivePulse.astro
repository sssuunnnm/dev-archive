---
// About 페이지용 인터랙티브 통계 위젯.
// 마우스를 따라다니는 스포트라이트 + 살짝 3D 틸트 + hover 시 카테고리별 breakdown 카운트업.
// 새 의존성 없이 vanilla JS/CSS로 구현 (CONVENTIONS 3-7 인터랙티브 데모 컨벤션과 같은 정신).
import { getCollection } from 'astro:content';
import { isVisible } from '../lib/content-visibility';
import { categories } from '../lib/categories';

const articles = await getCollection('articles', ({ data }) => isVisible(data.draft));

const total = articles.length;

const firstDate = articles.length
  ? new Date(Math.min(...articles.map((a) => a.data.date.valueOf())))
  : null;
const firstDateStr = firstDate ? firstDate.toISOString().slice(0, 10) : null;

const categoryCounts: Record<string, number> = {};
for (const a of articles) {
  categoryCounts[a.data.category] = (categoryCounts[a.data.category] ?? 0) + 1;
}
const categoryData = categories
  .map((c) => ({ key: c.key, label: c.label, count: categoryCounts[c.key] ?? 0 }))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);
const maxCount = Math.max(1, ...categoryData.map((c) => c.count));
---

<div
  class="pulse-card"
  id="archive-pulse"
  data-first-date={firstDateStr}
  data-total={total}
  tabindex="0"
>
  <div class="pulse-spotlight" aria-hidden="true"></div>

  <div class="pulse-headline">
    <p class="pulse-number font-accent text-accent dark:text-accent-dark" id="pulse-days">0</p>
    <p class="pulse-label">일째 기록 중 · 지금까지 <span id="pulse-total">0</span>개의 글</p>
  </div>

  <div class="pulse-breakdown" id="pulse-breakdown">
    {categoryData.map((c) => (
      <div class="pulse-row" data-cat={c.key}>
        <span class="pulse-row-label">{c.label}</span>
        <div class="pulse-row-track">
          <div class="pulse-row-bar" data-cat={c.key} style={`--target-width: ${(c.count / maxCount) * 100}%`}></div>
        </div>
        <span class="pulse-row-count" data-target={c.count}>0</span>
      </div>
    ))}
  </div>
</div>

<style>
  .pulse-card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    padding: 1.75rem 1.5rem;
    background: linear-gradient(145deg, rgb(249 250 251), rgb(243 244 246));
    transform-style: preserve-3d;
    transform: perspective(800px) rotateX(0deg) rotateY(0deg);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    outline: none;
  }

  :global(.dark) .pulse-card {
    background: linear-gradient(145deg, rgb(24 24 27), rgb(17 17 19));
  }

  .pulse-spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 50%),
      rgb(70 107 143 / 0.16),
      transparent 70%
    );
  }

  :global(.dark) .pulse-spotlight {
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 50%),
      rgb(143 173 199 / 0.14),
      transparent 70%
    );
  }

  .pulse-card:hover .pulse-spotlight,
  .pulse-card:focus-visible .pulse-spotlight {
    opacity: 1;
  }

  .pulse-headline {
    position: relative;
  }

  .pulse-number {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .pulse-label {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: rgb(107 114 128);
  }

  :global(.dark) .pulse-label {
    color: rgb(156 163 175);
  }

  .pulse-breakdown {
    position: relative;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
  }

  .pulse-card:hover .pulse-breakdown,
  .pulse-card:focus-visible .pulse-breakdown,
  .pulse-card.is-open .pulse-breakdown {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .pulse-breakdown > * {
    overflow: hidden;
  }

  .pulse-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr 2rem;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.875rem;
    font-size: 0.8125rem;
  }

  .pulse-row-label {
    color: rgb(75 85 99);
  }

  :global(.dark) .pulse-row-label {
    color: rgb(209 213 219);
  }

  .pulse-row-track {
    height: 0.375rem;
    border-radius: 999px;
    background: rgb(229 231 235);
    overflow: hidden;
  }

  :global(.dark) .pulse-row-track {
    background: rgb(63 63 70);
  }

  .pulse-row-bar {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pulse-card:hover .pulse-row-bar,
  .pulse-card:focus-visible .pulse-row-bar,
  .pulse-card.is-open .pulse-row-bar {
    width: var(--target-width);
  }

  .pulse-row-count {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: rgb(75 85 99);
  }

  :global(.dark) .pulse-row-count {
    color: rgb(209 213 219);
  }

  .pulse-row-bar[data-cat='development'] { background: var(--color-cat-development); }
  .pulse-row-bar[data-cat='infra'] { background: var(--color-cat-infra); }
  .pulse-row-bar[data-cat='cs'] { background: var(--color-cat-cs); }
  .pulse-row-bar[data-cat='ai'] { background: var(--color-cat-ai); }
  .pulse-row-bar[data-cat='study'] { background: var(--color-cat-study); }
  .pulse-row-bar[data-cat='certificates'] { background: var(--color-cat-certificates); }

  :global(.dark) .pulse-row-bar[data-cat='development'] { background: var(--color-cat-development-dark); }
  :global(.dark) .pulse-row-bar[data-cat='infra'] { background: var(--color-cat-infra-dark); }
  :global(.dark) .pulse-row-bar[data-cat='cs'] { background: var(--color-cat-cs-dark); }
  :global(.dark) .pulse-row-bar[data-cat='ai'] { background: var(--color-cat-ai-dark); }
  :global(.dark) .pulse-row-bar[data-cat='study'] { background: var(--color-cat-study-dark); }
  :global(.dark) .pulse-row-bar[data-cat='certificates'] { background: var(--color-cat-certificates-dark); }

  /* 모션을 줄여달라고 한 사용자에게는 틸트/스포트라이트 없이 값만 바로 보여준다 */
  @media (prefers-reduced-motion: reduce) {
    .pulse-card {
      transition: none;
      transform: none !important;
    }
    .pulse-spotlight {
      display: none;
    }
    .pulse-breakdown {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .pulse-row-bar {
      width: var(--target-width) !important;
    }
  }
</style>

<script>
  const card = document.getElementById('archive-pulse');
  if (!card) throw new Error('ArchivePulse: root element not found');

  const daysEl = document.getElementById('pulse-days');
  const totalEl = document.getElementById('pulse-total');
  if (!daysEl || !totalEl) throw new Error('ArchivePulse: expected elements not found');

  const firstDateStr = card.dataset.firstDate;
  const total = Number(card.dataset.total ?? '0');
  const days = firstDateStr
    ? Math.max(0, Math.floor((Date.now() - new Date(firstDateStr).getTime()) / 86_400_000))
    : 0;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // easeOutExpo 곡선으로 0 -> target까지 숫자를 채운다.
  function countUp(el: Element, target: number, duration = 900) {
    if (prefersReducedMotion || target === 0) {
      el.textContent = String(target);
      return;
    }
    const start = performance.now();
    const ease = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));
    function tick(now: number) {
      const t = Math.min(1, (now - start) / duration);
      el.textContent = String(Math.round(target * ease(t)));
      if (t < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  let played = false;
  function playIntro() {
    if (played) return;
    played = true;
    countUp(daysEl, days);
    countUp(totalEl, total);
    card
      .querySelectorAll<HTMLElement>('.pulse-row-count')
      .forEach((el) => countUp(el, Number(el.dataset.target ?? '0'), 700));
  }

  const observer = new IntersectionObserver(
    (entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        playIntro();
        observer.disconnect();
      }
    },
    { threshold: 0.4 }
  );
  observer.observe(card);

  if (!prefersReducedMotion) {
    card.addEventListener('pointermove', (e: PointerEvent) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      card.style.setProperty('--mx', `${x * 100}%`);
      card.style.setProperty('--my', `${y * 100}%`);
      const tiltRange = 5; // deg
      const rotateY = (x - 0.5) * tiltRange * 2;
      const rotateX = (0.5 - y) * tiltRange * 2;
      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });

    card.addEventListener('pointerleave', () => {
      card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg)';
    });
  }

  // 키보드 포커스로도 breakdown을 열 수 있게 (hover 전용 접근성 보완)
  card.addEventListener('focus', () => card.classList.add('is-open'));
  card.addEventListener('blur', () => card.classList.remove('is-open'));
</script>
