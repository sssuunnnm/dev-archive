---
// About 페이지용 인터랙티브 통계 위젯.
// 효과를 한 카드에 몰아넣지 않고 카드별로 하나씩 분산: 스포트라이트 카드, 틸트 카드,
// 카테고리별 바 카드. 새 의존성 없이 vanilla JS/CSS로 구현 (CONVENTIONS 3-7과 같은 정신).
import { getCollection } from 'astro:content';
import { isVisible } from '../lib/content-visibility';
import { categories } from '../lib/categories';

const articles = await getCollection('articles', ({ data }) => isVisible(data.draft));

const total = articles.length;

const firstDate = articles.length
  ? new Date(Math.min(...articles.map((a) => a.data.date.valueOf())))
  : null;
const firstDateStr = firstDate ? firstDate.toISOString().slice(0, 10) : null;

const categoryCounts: Record<string, number> = {};
for (const a of articles) {
  categoryCounts[a.data.category] = (categoryCounts[a.data.category] ?? 0) + 1;
}
const categoryData = categories
  .map((c) => ({ key: c.key, label: c.label, count: categoryCounts[c.key] ?? 0 }))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);
const maxCount = Math.max(1, ...categoryData.map((c) => c.count));
---

<div class="pulse-grid" id="archive-pulse" data-first-date={firstDateStr} data-total={total}>
  <div class="pulse-card pulse-card--spotlight" tabindex="0">
    <div class="pulse-spotlight" aria-hidden="true"></div>
    <p class="pulse-number font-accent text-accent dark:text-accent-dark" id="pulse-days">0</p>
    <p class="pulse-caption">일째 기록 중</p>
  </div>

  <div class="pulse-card pulse-card--tilt" tabindex="0">
    <p class="pulse-number font-accent text-accent dark:text-accent-dark" id="pulse-total">0</p>
    <p class="pulse-caption">지금까지 쓴 글</p>
  </div>

  {categoryData.map((c) => (
    <div class="pulse-card pulse-card--bar" tabindex="0">
      <p class="pulse-cat-count" data-target={c.count}>0</p>
      <p class="pulse-caption">{c.label}</p>
      <div class="pulse-cat-track">
        <div class="pulse-cat-fill" data-cat={c.key} style={`--target-width: ${(c.count / maxCount) * 100}%`}></div>
      </div>
    </div>
  ))}
</div>

<style>
  .pulse-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.75rem;
  }

  .pulse-card {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    padding: 1.25rem 1rem;
    background: rgb(249 250 251);
    outline: none;
  }

  :global(.dark) .pulse-card {
    background: rgb(24 24 27 / 0.6);
  }

  .pulse-number {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .pulse-caption {
    margin-top: 0.375rem;
    font-size: 0.75rem;
    color: rgb(156 163 175);
  }

  /* 스포트라이트 카드 — 마우스를 따라다니는 은은한 빛 */
  .pulse-card--spotlight {
    transition: background 0.2s ease;
  }

  .pulse-spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(180px circle at var(--mx, 50%) var(--my, 50%), rgb(70 107 143 / 0.18), transparent 70%);
  }

  :global(.dark) .pulse-spotlight {
    background: radial-gradient(180px circle at var(--mx, 50%) var(--my, 50%), rgb(143 173 199 / 0.16), transparent 70%);
  }

  .pulse-card--spotlight:hover .pulse-spotlight,
  .pulse-card--spotlight:focus-visible .pulse-spotlight {
    opacity: 1;
  }

  /* 틸트 카드 — 마우스 위치에 따라 살짝 3D로 기울어짐 */
  .pulse-card--tilt {
    transform: perspective(600px) rotateX(0deg) rotateY(0deg);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* 카테고리 바 카드 — hover 시 막대가 채워짐 */
  .pulse-cat-count {
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .pulse-cat-track {
    margin-top: 0.625rem;
    height: 0.3125rem;
    border-radius: 999px;
    background: rgb(229 231 235);
    overflow: hidden;
  }

  :global(.dark) .pulse-cat-track {
    background: rgb(63 63 70);
  }

  .pulse-cat-fill {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pulse-card--bar:hover .pulse-cat-fill,
  .pulse-card--bar:focus-visible .pulse-cat-fill {
    width: var(--target-width);
  }

  .pulse-cat-fill[data-cat='development'] { background: var(--color-cat-development); }
  .pulse-cat-fill[data-cat='infra'] { background: var(--color-cat-infra); }
  .pulse-cat-fill[data-cat='cs'] { background: var(--color-cat-cs); }
  .pulse-cat-fill[data-cat='ai'] { background: var(--color-cat-ai); }
  .pulse-cat-fill[data-cat='study'] { background: var(--color-cat-study); }
  .pulse-cat-fill[data-cat='certificates'] { background: var(--color-cat-certificates); }

  :global(.dark) .pulse-cat-fill[data-cat='development'] { background: var(--color-cat-development-dark); }
  :global(.dark) .pulse-cat-fill[data-cat='infra'] { background: var(--color-cat-infra-dark); }
  :global(.dark) .pulse-cat-fill[data-cat='cs'] { background: var(--color-cat-cs-dark); }
  :global(.dark) .pulse-cat-fill[data-cat='ai'] { background: var(--color-cat-ai-dark); }
  :global(.dark) .pulse-cat-fill[data-cat='study'] { background: var(--color-cat-study-dark); }
  :global(.dark) .pulse-cat-fill[data-cat='certificates'] { background: var(--color-cat-certificates-dark); }

  @media (prefers-reduced-motion: reduce) {
    .pulse-card--tilt {
      transition: none;
      transform: none !important;
    }
    .pulse-spotlight {
      display: none;
    }
    .pulse-cat-fill {
      width: var(--target-width) !important;
    }
  }
</style>

<script>
  const grid = document.getElementById('archive-pulse');
  if (!grid) throw new Error('ArchivePulse: root element not found');

  const daysEl = document.getElementById('pulse-days');
  const totalEl = document.getElementById('pulse-total');
  if (!daysEl || !totalEl) throw new Error('ArchivePulse: expected elements not found');

  const firstDateStr = grid.dataset.firstDate;
  const total = Number(grid.dataset.total ?? '0');
  const days = firstDateStr
    ? Math.max(0, Math.floor((Date.now() - new Date(firstDateStr).getTime()) / 86_400_000))
    : 0;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // easeOutExpo 곡선으로 0 -> target까지 숫자를 채운다.
  function countUp(el: Element, target: number, duration = 900) {
    if (prefersReducedMotion || target === 0) {
      el.textContent = String(target);
      return;
    }
    const start = performance.now();
    const ease = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));
    function tick(now: number) {
      const t = Math.min(1, (now - start) / duration);
      el.textContent = String(Math.round(target * ease(t)));
      if (t < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  let played = false;
  function playIntro() {
    if (played) return;
    played = true;
    countUp(daysEl, days);
    countUp(totalEl, total);
    grid
      .querySelectorAll<HTMLElement>('.pulse-cat-count')
      .forEach((el) => countUp(el, Number(el.dataset.target ?? '0'), 700));
  }

  const observer = new IntersectionObserver(
    (entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        playIntro();
        observer.disconnect();
      }
    },
    { threshold: 0.4 }
  );
  observer.observe(grid);

  if (!prefersReducedMotion) {
    const spotlightCard = grid.querySelector<HTMLElement>('.pulse-card--spotlight');
    spotlightCard?.addEventListener('pointermove', (e: PointerEvent) => {
      const rect = spotlightCard.getBoundingClientRect();
      spotlightCard.style.setProperty('--mx', `${((e.clientX - rect.left) / rect.width) * 100}%`);
      spotlightCard.style.setProperty('--my', `${((e.clientY - rect.top) / rect.height) * 100}%`);
    });

    const tiltCard = grid.querySelector<HTMLElement>('.pulse-card--tilt');
    tiltCard?.addEventListener('pointermove', (e: PointerEvent) => {
      const rect = tiltCard.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      const tiltRange = 8; // deg
      const rotateY = (x - 0.5) * tiltRange * 2;
      const rotateX = (0.5 - y) * tiltRange * 2;
      tiltCard.style.transform = `perspective(600px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });
    tiltCard?.addEventListener('pointerleave', () => {
      tiltCard.style.transform = 'perspective(600px) rotateX(0deg) rotateY(0deg)';
    });
  }
</script>
