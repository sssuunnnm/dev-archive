---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { categories, getCategoryLabel, getCategoryColorClass } from '../lib/categories';
import { getRelatedPosts, getSeriesNav } from '../lib/related';
import { isVisible } from '../lib/content-visibility';
import { formatTagLabel } from '../lib/level';

interface Props {
  entry: any; // CollectionEntry<'articles'>
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const {
  title, description, date, updated,
  category, technology, tags, type,
} = entry.data;

const allArticles = await getCollection('articles', ({ data }) => isVisible(data.draft));
const related = getRelatedPosts(entry, allArticles);
const seriesNav = getSeriesNav(entry, allArticles);

// DESIGN_RULES 4-2: 이 글이 속한 프로젝트 배너 (양방향 연결)
const linkedProjects = entry.data.projects?.length
  ? (await getCollection('projects', ({ data }) => isVisible(data.draft))).filter((p) =>
      entry.data.projects.includes(p.id)
    )
  : [];

const categoryLabel = categories.find((c) => c.key === category)?.label ?? category;
const base = import.meta.env.BASE_URL;

// 읽는 시간 계산 (본문 글자 수 기반 대략치)
const wordCount = entry.body?.length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 400));
---

<BaseLayout title={title} description={description}>
  <Breadcrumb
    items={[
      { label: 'Home', href: base },
      { label: categoryLabel, href: `${base}${category}`, class: `font-medium ${getCategoryColorClass(category)}` },
    ]}
  />

  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold mb-2 font-accent">{title}</h1>

      <div class="flex flex-wrap gap-2 text-xs text-gray-400 mb-3">
        <span>{type}</span>
        <span>·</span>
        <span>{readingTime} min read</span>
        <span>·</span>
        <span>{date.toISOString().slice(0, 10)}</span>
        {updated && <span>(Updated {updated.toISOString().slice(0, 10)})</span>}
      </div>

      <div class="flex flex-wrap items-center gap-2">
        {technology.map((t: string) => (
          <span class="text-xs border rounded px-2 py-1 dark:border-gray-700">{t}</span>
        ))}
        {tags.map((t: string) => (
          <a
            href={`${base}tags/${encodeURIComponent(t)}`}
            title={t}
            class="text-xs text-accent dark:text-accent-dark hover:underline"
          >
            {formatTagLabel(t)}
          </a>
        ))}
      </div>
    </header>

    {linkedProjects.length > 0 && (
      <p class="mb-6 text-sm text-gray-500 border-l-2 border-accent dark:border-accent-dark pl-3">
        이 글은{' '}
        {linkedProjects.map((p, i) => (
          <>
            <a href={`${base}projects/${p.id}`} class="text-accent dark:text-accent-dark hover:underline">
              {p.data.title}
            </a>
            {i < linkedProjects.length - 1 ? ', ' : ' '}
          </>
        ))}
        프로젝트에서 작성되었습니다.
      </p>
    )}

    {headings.length > 0 && (
      <details class="mb-8 border rounded-lg p-4 text-sm dark:border-gray-700">
        <summary class="font-semibold cursor-pointer select-none">목차</summary>
        <ul class="space-y-1 mt-2">
          {headings.filter((h) => h.depth <= 3).map((h) => (
            <li style={`margin-left: ${(h.depth - 2) * 12}px`}>
              <a href={`#${h.slug}`} class="text-gray-600 hover:underline dark:text-gray-400">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}

    <div class="prose prose-gray dark:prose-invert max-w-none">
      <slot />
    </div>

    {seriesNav && (
      <nav class="mt-12 pt-6 border-t dark:border-gray-700 flex justify-between text-sm">
        <div>
          {seriesNav.prev && (
            <a href={`${base}${seriesNav.prev.data.category}/${seriesNav.prev.id}`} class="hover:underline">
              ← {seriesNav.prev.data.title}
            </a>
          )}
        </div>
        <div>
          {seriesNav.next && (
            <a href={`${base}${seriesNav.next.data.category}/${seriesNav.next.id}`} class="hover:underline">
              {seriesNav.next.data.title} →
            </a>
          )}
        </div>
      </nav>
    )}

    {related.length > 0 && (
      <footer class="mt-8 pt-6 border-t dark:border-gray-700">
        <p class="font-semibold mb-2">관련 글</p>
        <ul class="space-y-2">
          {related.map((post) => (
            <li class="flex items-center gap-2">
              <span class="text-xs text-gray-400 border rounded px-1.5 py-0.5 dark:border-gray-700">
                {getCategoryLabel(post.data.category)}
              </span>
              <a
                href={`${base}${post.data.category}/${post.id}`}
                class="text-accent dark:text-accent-dark hover:underline"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </footer>
    )}
  </article>
</BaseLayout>