---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { categories } from '../lib/categories';
import { getRelatedPosts, getSeriesNav } from '../lib/related';

interface Props {
  entry: any; // CollectionEntry<'articles'>
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const {
  title, description, date, updated,
  category, technology, tags, type,
} = entry.data;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const related = getRelatedPosts(entry, allArticles);
const seriesNav = getSeriesNav(entry, allArticles);

const categoryLabel = categories.find((c) => c.key === category)?.label ?? category;
const base = import.meta.env.BASE_URL;

// 읽는 시간 계산 (본문 글자 수 기반 대략치)
const wordCount = entry.body?.length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 400));
---

<BaseLayout title={title} description={description}>
  <Breadcrumb
    items={[
      { label: 'Home', href: base },
      { label: categoryLabel, href: `${base}${category}` },
      { label: title },
    ]}
  />

  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold mb-2">{title}</h1>
      <p class="text-gray-500 mb-3">{description}</p>

      <div class="flex flex-wrap gap-2 text-xs text-gray-400 mb-3">
        <span>{category}</span>
        <span>·</span>
        <span>{type}</span>
        <span>·</span>
        <span>{readingTime} min read</span>
        <span>·</span>
        <span>{date.toISOString().slice(0, 10)}</span>
        {updated && <span>(Updated {updated.toISOString().slice(0, 10)})</span>}
      </div>

      <div class="flex flex-wrap gap-2 mb-2">
        {technology.map((t: string) => (
          <span class="text-xs border rounded px-2 py-1 dark:border-gray-700">{t}</span>
        ))}
      </div>

      <div class="flex flex-wrap gap-2">
        {tags.map((t: string) => (
          <a
            href={`${base}tags/${encodeURIComponent(t)}`}
            class="text-xs text-blue-600 hover:underline"
          >
            #{t}
          </a>
        ))}
      </div>
    </header>

    {headings.length > 0 && (
      <nav class="mb-8 border rounded-lg p-4 text-sm dark:border-gray-700">
        <p class="font-semibold mb-2">목차</p>
        <ul class="space-y-1">
          {headings.filter((h) => h.depth <= 3).map((h) => (
            <li style={`margin-left: ${(h.depth - 2) * 12}px`}>
              <a href={`#${h.slug}`} class="text-gray-600 hover:underline dark:text-gray-400">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="leading-relaxed">
      <slot />
    </div>

    {seriesNav && (
      <nav class="mt-12 pt-6 border-t dark:border-gray-700 flex justify-between text-sm">
        <div>
          {seriesNav.prev && (
            <a href={`${base}${seriesNav.prev.data.category}/${seriesNav.prev.id}`} class="hover:underline">
              ← {seriesNav.prev.data.title}
            </a>
          )}
        </div>
        <div>
          {seriesNav.next && (
            <a href={`${base}${seriesNav.next.data.category}/${seriesNav.next.id}`} class="hover:underline">
              {seriesNav.next.data.title} →
            </a>
          )}
        </div>
      </nav>
    )}

    {related.length > 0 && (
      <footer class="mt-8 pt-6 border-t dark:border-gray-700">
        <p class="font-semibold mb-2">관련 글</p>
        <ul class="space-y-1">
          {related.map((post) => (
            <li>
              <a
                href={`${base}${post.data.category}/${post.id}`}
                class="text-blue-600 hover:underline"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </footer>
    )}
  </article>
</BaseLayout>